<reactiveui:ReactiveUserControl
    x:Class="NexusLink.Views.StatusBarView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:reactiveui="http://reactiveui.net"
    xmlns:resx="clr-namespace:ServiceLib.Resx;assembly=ServiceLib"
    xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
    xmlns:vms="clr-namespace:ServiceLib.ViewModels;assembly=ServiceLib"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:TypeArguments="vms:StatusBarViewModel"
    Style="{StaticResource ViewGlobal}"
    mc:Ignorable="d">
    <Grid>
        <tb:TaskbarIcon
            x:Name="tbNotify"
            IconSource="/Resources/NexusLink.ico"
            NoLeftClickDelay="True"
            ToolTipText="畅连">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu Style="{StaticResource DefContextMenu}" Opened="TrayMenu_Opened">
                    <MenuItem
                        x:Name="menuTrayStatus"
                        Height="{StaticResource MenuItemHeight}"
                        Header="畅连"
                        IsEnabled="False" />
                    <Separator />
                    <MenuItem
                        x:Name="menuTrayConnect"
                        Height="{StaticResource MenuItemHeight}"
                        Header="立即连接"
                        AutomationProperties.Name="连接或断开"
                        Click="TrayConnect_Click" />
                    <MenuItem
                        x:Name="menuTrayRefresh"
                        Height="{StaticResource MenuItemHeight}"
                        Header="刷新与测速"
                        AutomationProperties.Name="刷新与测速"
                        Click="TrayRefresh_Click" />
                    <MenuItem
                        x:Name="menuTrayShowMain"
                        Height="{StaticResource MenuItemHeight}"
                        Header="打开畅连"
                        AutomationProperties.Name="打开畅连"
                        Click="TrayShowMain_Click" />
                    <Separator />
                    <MenuItem
                        x:Name="menuExit"
                        Height="{StaticResource MenuItemHeight}"
                        Header="{x:Static resx:ResUI.menuExit}" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</reactiveui:ReactiveUserControl>
