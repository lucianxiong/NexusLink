<UserControl
    x:Class="NexusLink.Views.KeeperOverview"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    Background="#191919"
    d:DesignHeight="700"
    d:DesignWidth="720"
    mc:Ignorable="d">

    <UserControl.Resources>
        <!-- 主按钮：纯白底黑字，圆角（MaterialDesign 主色已全局切为 Orange，悬停为暖橙） -->
        <Style
            x:Key="BtnPrimary"
            BasedOn="{StaticResource MaterialDesignRaisedButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="#FFFFFF" />
            <Setter Property="Foreground" Value="#111111" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        </Style>
        <!-- 副按钮：黑底白字描边，圆角（黑白双色统一） -->
        <Style
            x:Key="BtnAccent"
            BasedOn="{StaticResource MaterialDesignRaisedButton}"
            TargetType="Button">
            <Setter Property="Background" Value="#111111" />
            <Setter Property="BorderBrush" Value="#66FFFFFF" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="materialDesign:ButtonAssist.CornerRadius" Value="10" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer x:Name="OverviewScroll" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
        <StackPanel
            Margin="0,8,0,24"
            MaxWidth="820"
            HorizontalAlignment="Stretch">

            <!-- ============ 1. 连接主卡 ============ -->
            <Border
                Background="#242424"
                BorderBrush="#393939"
                BorderThickness="1"
                CornerRadius="12"
                Padding="24,20">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    x:Name="Dot"
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Fill="#6E6E6E">
                                    <Ellipse.Effect>
                                        <DropShadowEffect
                                            x:Name="DotGlow"
                                            BlurRadius="18"
                                            Color="#919191"
                                            Opacity="0"
                                            ShadowDepth="0" />
                                    </Ellipse.Effect>
                                </Ellipse>
                                <TextBlock
                                    x:Name="HeroTitle"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="26"
                                    FontWeight="Bold"
                                    Foreground="#F5F5F5"
                                    Text="启动中…" />
                            </StackPanel>
                            <TextBlock
                                x:Name="HeroRoute"
                                Margin="2,12,0,0"
                                FontSize="15"
                                Foreground="#C9C9C9"
                                TextWrapping="Wrap"
                                Text="正在确认连接状态…" />
                            <TextBlock
                                x:Name="HeroMeta"
                                Margin="2,6,0,0"
                                FontSize="12"
                                Foreground="#A8A8A8"
                                TextWrapping="Wrap"
                                Text="" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <Button
                                x:Name="BtnSettings" AutomationProperties.Name="应用设置"
                                Width="34"
                                Height="34"
                                Margin="0,0,0,10"
                                Padding="0"
                                HorizontalAlignment="Right"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                ToolTip="参数设置（含开机自启）">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Foreground="#9A9A9A"
                                    Kind="CogOutline" />
                            </Button>
                            <Border
                                x:Name="DelayPill"
                                Padding="14,7"
                                HorizontalAlignment="Right"
                                Background="#1F6E6E6E"
                                BorderBrush="#6E6E6E"
                                BorderThickness="1"
                                CornerRadius="15"
                                ToolTip="延迟：信号从你电脑到节点再回来的往返时间，越小越快。300 毫秒内显示绿色（快），800 以内橙色（一般），更慢显示红色">
                                <TextBlock
                                    x:Name="DelayText"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Foreground="#A8A8A8"
                                    Text="延迟 --" />
                            </Border>
                            <Border
                                x:Name="SpeedPill"
                                Margin="0,8,0,0"
                                Padding="14,7"
                                HorizontalAlignment="Right"
                                Background="#1F6E6E6E"
                                BorderBrush="#6E6E6E"
                                BorderThickness="1"
                                CornerRadius="15"
                                ToolTip="网速：每秒经过畅连节点的下载/上传数据量，只统计走代理的流量（右下角系统悬浮窗统计的是全电脑流量，是另一个软件的功能）">
                                <TextBlock
                                    x:Name="SpeedText"
                                    FontSize="13.5"
                                    FontWeight="SemiBold"
                                    Foreground="#A8A8A8"
                                    Text="网速 --" />
                            </Border>
                        </StackPanel>
                    </Grid>
                    <Button
                        x:Name="BtnConnect"
                        Height="44"
                        Margin="0,16,0,0"
                        HorizontalAlignment="Left"
                        MinWidth="160"
                        Content="立即连接"
                        FontSize="15.5"
                        Style="{StaticResource BtnPrimary}" />
                </StackPanel>
            </Border>

            <!-- ============ 2. 三张等大卡 ============ -->
            <Grid Margin="0,14,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Border
                    Background="#242424"
                    BorderBrush="#393939"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Foreground="#B8B8B8"
                                    Kind="Reload" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14.5"
                                    FontWeight="SemiBold"
                                    Foreground="#E5E5E5"
                                    Text="刷新节点" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11.5"
                                Foreground="#A3A3A3"
                                LineHeight="17"
                                Text="真测速换血：通过两个 HTTPS 目标检测的节点才入池"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            x:Name="BtnRefresh"
                            Height="40"
                            DockPanel.Dock="Bottom"
                            VerticalAlignment="Bottom"
                            Content="刷新与测速"
                            FontSize="13"
                            Style="{StaticResource BtnAccent}" />
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="2"
                    Background="#242424"
                    BorderBrush="#393939"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Foreground="#B8B8B8"
                                    Kind="ArrowDecisionOutline" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14.5"
                                    FontWeight="SemiBold"
                                    Foreground="#E5E5E5"
                                    Text="自动切换" />
                            </StackPanel>
                            <TextBlock
                                Margin="0,8,0,0"
                                FontSize="11.5"
                                Foreground="#A3A3A3"
                                LineHeight="17"
                                Text="线路变慢或断掉时，秒级跳到最快的那条"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton
                            x:Name="TbAutoSwitch" AutomationProperties.Name="自动切换"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </DockPanel>
                </Border>

                <Border
                    Grid.Column="4"
                    Background="#242424"
                    BorderBrush="#393939"
                    BorderThickness="1"
                    CornerRadius="12"
                    Padding="18,16">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Foreground="#B8B8B8"
                                    Kind="BookClockOutline" />
                                <TextBlock
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="14.5"
                                    FontWeight="SemiBold"
                                    Foreground="#E5E5E5"
                                    Text="定时刷新" />
                            </StackPanel>
                            <TextBlock
                                x:Name="DailyDesc"
                                Margin="0,8,0,0"
                                FontSize="11.5"
                                Foreground="#A3A3A3"
                                LineHeight="17"
                                Text="按设置间隔自动更新节点"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <ToggleButton
                            x:Name="TbDaily" AutomationProperties.Name="定时刷新"
                            DockPanel.Dock="Bottom"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Bottom"
                            Style="{StaticResource MaterialDesignSwitchToggleButton}" />
                    </DockPanel>
                </Border>
            </Grid>

            <!-- 公益池风险提示：节点由陌生志愿者提供。放在线路列表上方，首屏即可看到 -->
            <TextBlock
                Margin="2,0,2,0"
                FontSize="12"
                Foreground="#B8B8B8"
                LineHeight="18"
                TextWrapping="Wrap"
                Text="注意：线路列表中的节点来自公益节点池，由陌生志愿者提供，可能记录你访问了哪些网站。请勿在不信任的线路上登录网银、支付等敏感账号。" />
            <!-- ============ 3. 线路列表卡 ============ -->
            <Border
                Background="#242424"
                BorderBrush="#393939"
                BorderThickness="1"
                CornerRadius="12"
                Margin="0,14,0,0"
                Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock FontSize="14.5" FontWeight="SemiBold" Foreground="#E5E5E5" Text="主池线路" />
                            <Border
                                Margin="10,0,0,0"
                                Padding="9,3"
                                Background="#26FFFFFF"
                                BorderBrush="#66FFFFFF"
                                BorderThickness="1"
                                CornerRadius="10">
                                <TextBlock
                                    x:Name="CountBadge"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="#E5E5E5"
                                    Text="0" />
                            </Border>
                        </StackPanel>
                        <TextBlock
                            x:Name="LastRefreshText"
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="#A8A8A8"
                            Text="" />
                    </Grid>
                    <Border Height="1" Margin="0,12,0,4" Background="#333333" />
                    <ListView
                        x:Name="LvNodes"
                        
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="#E5E5E5"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Disabled"
                        SelectionMode="Single" />
                </StackPanel>
            </Border>

            
        </StackPanel>
    </ScrollViewer>
</UserControl>


