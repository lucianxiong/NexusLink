<UserControl x:Class="NexusLink.Views.KeeperHomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="clr-namespace:NexusLink.Views"
             Background="#191919" Foreground="#F1F1F1" FontFamily="Segoe UI, Microsoft YaHei UI">
    <UserControl.Resources>
        <Style TargetType="RadioButton" x:Key="Nav">
            <Setter Property="Foreground" Value="#CACACA"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Surface" Background="Transparent" CornerRadius="7" Padding="12,10">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Surface" Property="Background" Value="#262626"/></Trigger>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="Surface" Property="Background" Value="#303030"/><Setter Property="Foreground" Value="#F2F2F2"/></Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Surface" Property="Background" Value="#414141"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="TextBlock" x:Key="Muted"><Setter Property="Foreground" Value="#B2B2B2"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="Border" x:Key="Panel"><Setter Property="Background" Value="#212121"/><Setter Property="BorderBrush" Value="#373737"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="22"/></Style>
        <Style TargetType="Button" x:Key="Action" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
            <Setter Property="Foreground" Value="#EBEBEB"/><Setter Property="BorderBrush" Value="#585858"/>
            <Setter Property="MinHeight" Value="36"/><Setter Property="Padding" Value="15,4"/><Setter Property="Margin" Value="0,0,10,0"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions><ColumnDefinition Width="136"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
        <Border Background="#151515" BorderBrush="#323232" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,25,16,17">
                <StackPanel>
                    <RadioButton Style="{StaticResource Nav}" GroupName="Workspace" Tag="0" Content="首页总览" IsChecked="True" Checked="Navigate"/>
                    <RadioButton Style="{StaticResource Nav}" GroupName="Workspace" Tag="1" Content="节点管理" Checked="Navigate"/>
                    <RadioButton Style="{StaticResource Nav}" GroupName="Workspace" Tag="2" Content="自动优化" Checked="Navigate"/>
                    <RadioButton Style="{StaticResource Nav}" GroupName="Workspace" Tag="3" Content="设置" Checked="Navigate"/>
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Column="1" Margin="24,22,24,14" MaxWidth="820">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock x:Name="PageTitle" Text="首页总览" FontSize="29" FontWeight="SemiBold" Margin="0,0,0,20"/>
            <views:KeeperOverview x:Name="HomePage" Grid.Row="1"/>
            <DockPanel x:Name="NodesPage" Grid.Row="1" Visibility="Collapsed">
                <Grid DockPanel.Dock="Top" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <ComboBox x:Name="PoolFilter" SelectedIndex="0" SelectionChanged="PoolChanged" Margin="0,0,16,0"
                              MinWidth="100" AutomationProperties.Name="节点池">
                        <ComboBoxItem Content="线路"/>
                        <ComboBoxItem Content="未入池"/>
                    </ComboBox>
                    <TextBox x:Name="Search" Grid.Column="1" Foreground="#F1F1F1" CaretBrush="#F1F1F1" Margin="0,0,16,0"
                             AutomationProperties.Name="搜索节点" TextChanged="SearchChanged"/>
                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="SelectModeText" Style="{StaticResource Muted}" TextWrapping="NoWrap" Margin="0,0,14,0" VerticalAlignment="Center"/>
                        <Button x:Name="UseNodeButton" Content="用这个节点" Style="{StaticResource Action}" Click="UseSelectedNode" IsEnabled="False" AutomationProperties.Name="用这个节点"/>
                        <Button x:Name="AutoSelectButton" Content="恢复自动" Style="{StaticResource Action}" Click="UseAutoSelect" IsEnabled="False" AutomationProperties.Name="恢复自动"/>
                        <Button x:Name="NodesRefreshButton" Content="刷新与测速" Style="{StaticResource Action}" Click="Refresh" Margin="0"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="NodeSummary" DockPanel.Dock="Top" Style="{StaticResource Muted}" Margin="0,0,0,10"/>
                <DataGrid x:Name="Nodes" IsReadOnly="True" AutoGenerateColumns="False" CanUserAddRows="False" RowHeight="36"
                          Foreground="#EFEFEF" Background="#212121" RowBackground="#212121" AlternatingRowBackground="#262626"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#373737" HeadersVisibility="Column"
                          MouseDoubleClick="NodesDoubleClick">
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="ToolTip" Value="{Binding Tip}"/>
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.ColumnHeaderStyle><Style TargetType="DataGridColumnHeader">
                        <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/>
                        <Setter Property="Padding" Value="9,8"/>
                    </Style></DataGrid.ColumnHeaderStyle>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="节点" Width="2*">
                            <DataGridTemplateColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="名称来自实测出口和协议，右侧小字是实测出口 IP。悬停某一行可看节点池原名"/>
                                </Style>
                            </DataGridTemplateColumn.HeaderStyle>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding NameSub}" Margin="8,0,0,0" FontSize="11" Opacity="0.55" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="出口" Binding="{Binding Exit}" Width="140">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="实测出口：经该节点访问 IP 归属服务查得，随每次换血更新。节点名称就是按这个实测结果显示的"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="类型" Binding="{Binding NetType}" Width="58">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="出口 IP 类型：机房或家宽"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="安全" Binding="{Binding Security}" Width="52">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="高 = TLS / Reality 加密；中 = 已加密但流量特征可识别。弱加密、明文、跳过证书校验的节点不入池"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="稳定" Binding="{Binding Stability}" Width="62">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="高 = 出现 ≥ 3 天且通过率 ≥ 90%；中 = 出现 ≥ 1 天且通过率 ≥ 70%；低 = 记录不足 1 天"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="延迟" Binding="{Binding LatencyMs, TargetNullValue=—, StringFormat={}{0} ms}" Width="80">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="内核最近一次测速；没有记录时显示上次换血的实测值"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="速度" Binding="{Binding Speed}" Width="88">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="换血时经该节点实际下载测得；没测过的显示 —"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="来源" Binding="{Binding Source}" Width="130">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="该节点来自哪个公益节点池"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                        <DataGridTextColumn Header="状态" Binding="{Binding State}" Width="66">
                            <DataGridTextColumn.HeaderStyle>
                                <Style TargetType="DataGridColumnHeader">
                                    <Setter Property="Background" Value="#2E2E2E"/><Setter Property="Foreground" Value="#DADADA"/><Setter Property="Padding" Value="9,8"/>
                                    <Setter Property="ToolTip" Value="使用中 = 已连接，流量正走这条线路；当前线路 = 还没连接时，点「立即连接」后会走的线路"/>
                                </Style>
                            </DataGridTextColumn.HeaderStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
            <ScrollViewer x:Name="AutoPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <CheckBox x:Name="AutoSwitch" Foreground="#F1F1F1" Content="自动切换" Click="SwitchChanged"/>
                            <TextBlock Text="开启：按 安全 &gt; 稳定 &gt; 带宽 &gt; 延迟 自动选路，断线时自动换线。关闭：锁定当前节点，可在节点页手动更换。" Style="{StaticResource Muted}" Margin="0,7,0,18"/>
                            <CheckBox x:Name="AutoRefresh" Foreground="#F1F1F1" Content="定时刷新" Click="RefreshChanged"/>
                            <TextBlock x:Name="Interval" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <ScrollViewer x:Name="SettingsPage" Grid.Row="1" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border Style="{StaticResource Panel}">
                        <StackPanel>
                            <TextBlock Text="应用设置" FontSize="18" FontWeight="SemiBold"/>
                            <TextBlock Text="开机自动启动、启动后隐藏窗口、分流规则自动更新。" Style="{StaticResource Muted}" Margin="0,7,0,16"/>
                            <Button Content="打开设置" Click="OpenSettings" Style="{StaticResource Action}" HorizontalAlignment="Left"/>
                            <TextBlock Text="节点延迟上限" FontSize="18" FontWeight="SemiBold" Margin="0,22,0,6"/>
                            <ComboBox x:Name="LatencyLimit" SelectionChanged="LatencyLimitChanged" MinWidth="230" HorizontalAlignment="Left"
                                      AutomationProperties.Name="节点延迟上限">
                                <ComboBoxItem Content="500 毫秒"/>
                                <ComboBoxItem Content="800 毫秒"/>
                                <ComboBoxItem Content="1200 毫秒"/>
                            </ComboBox>
                            <TextBlock Text="安全且实测延迟低于上限的节点直接入池，延迟超标的不入池。选路顺序：安全 &gt; 稳定 &gt; 带宽 &gt; 延迟，在用的节点只要没问题就不换" Style="{StaticResource Muted}" Margin="0,7,0,0"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
            <Border Grid.Row="2" BorderBrush="#3B3B3B" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,14,0,0">
                <StackPanel>
                    <ProgressBar x:Name="Busy" Height="3" IsIndeterminate="True" Visibility="Collapsed" Margin="0,0,0,7"/>
                    <TextBlock x:Name="TaskStatus" Style="{StaticResource Muted}" AutomationProperties.LiveSetting="Polite"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

